    { "title": "CPU usage", "type": "timeseries", "targets": [{ "expr": "process_cpu_usage" }] },
    { "title": "Memory usage", "type": "timeseries", "targets": [{ "expr": "sum(jvm_memory_used_bytes) by (application)" }] },
    { "title": "Requests per tenant", "type": "timeseries", "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (application)" }] }
